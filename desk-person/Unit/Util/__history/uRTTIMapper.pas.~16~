unit uRTTIMapper;

interface

uses
  System.Rtti, System.SysUtils, Vcl.StdCtrls, Vcl.ComCtrls, Vcl.Mask,
  System.TypInfo, System.Classes;

procedure MapFormToObject(AForm: TComponent; AObject: TObject);
procedure MapObjectToForm(AObject: TObject; AForm: TComponent);

implementation

procedure MapFormToObject(AForm: TComponent; AObject: TObject);
var
  ctx: TRttiContext;
  rttiType: TRttiType;
  prop: TRttiProperty;
  compName: string;
  comp: TComponent;
  value: TValue;
begin
  ctx := TRttiContext.Create;
  rttiType := ctx.GetType(AObject.ClassType);

  for prop in rttiType.GetProperties do
  begin
    comp := AForm.FindComponent('edt' + prop.Name);

    if not Assigned(comp) then
      comp := AForm.FindComponent('cb' + prop.Name);

    if not Assigned(comp) then
      comp := AForm.FindComponent('dt' + prop.Name);

    if not Assigned(comp) then
      Continue;

    if comp is TEdit then
    begin
      if prop.PropertyType.TypeKind = tkInt64 then
      begin
        if Trim(TEdit(comp).Text) <> EmptyStr then
          value := StrToInt64(TEdit(comp).Text)
        else
          value := 0;
      end
      else
        value := TEdit(comp).Text;
    end

    else if comp is TMaskEdit then
    begin
      if prop.PropertyType.TypeKind = tkInt64 then
      begin
        if Trim(TMaskEdit(comp).Text) <> EmptyStr then
          value := StrToInt64(TMaskEdit(comp).Text)
        else
          value := 0;
      end
      else
        value := TMaskEdit(comp).Text;
    end

    else if comp is TComboBox then
    begin
      value := TComboBox(comp).Text;
    end

    else if comp is TDateTimePicker then
    begin
      value := TDateTimePicker(comp).Date;
    end

    else
      Continue;

    prop.SetValue(AObject, value);
  end;
end;

procedure MapObjectToForm(AObject: TObject; AForm: TComponent);
var
  ctx: TRttiContext;
  rttiType: TRttiType;
  prop: TRttiProperty;
  comp: TComponent;
  value: TValue;
  strValue: string;
begin
  ctx := TRttiContext.Create;
  rttiType := ctx.GetType(AObject.ClassType);

  for prop in rttiType.GetProperties do
  begin
    comp := AForm.FindComponent('edt' + prop.Name);

    if not Assigned(comp) then
      comp := AForm.FindComponent('cb' + prop.Name);

    if not Assigned(comp) then
      comp := AForm.FindComponent('dt' + prop.Name);

    if not Assigned(comp) then
      Continue;

    value := prop.GetValue(AObject);

    case prop.PropertyType.TypeKind of

      tkInteger, tkInt64:
        strValue := value.ToString;

      tkFloat:
        begin
          if prop.PropertyType.Name = 'TDate' then
          begin
            if comp is TDateTimePicker then
              TDateTimePicker(comp).Date := value.AsExtended
            else
              strValue := DateToStr(value.AsExtended);
          end
          else
            strValue := FloatToStr(value.AsExtended);
        end;

      tkString, tkUString, tkLString, tkWString:
        strValue := value.AsString;

    else
      Continue;
    end;

    if comp is TEdit then
      TEdit(comp).Text := strValue

    else if comp is TMaskEdit then
      TMaskEdit(comp).Text := strValue

    else if comp is TComboBox then
      TComboBox(comp).Text := strValue;
  end;
end;

end.
